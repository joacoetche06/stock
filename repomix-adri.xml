        uses: actions/checkout@v4

      - name: Instalar Node.js 20
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Instalar Python 3.11 para SQLite
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Actualizar herramientas de C++
        run: npm install -g node-gyp

      - name: Instalar dependencias del Backend
        working-directory: ./backend
        run: |
          npm install sqlite3@latest
          npm install

      - name: Compilar código TypeScript
        working-directory: ./backend
        run: npm run build

      - name: Empaquetar la aplicación con Electron
        working-directory: ./backend
        run: npm run empaquetar

      - name: Guardar el .exe para descargar
        uses: actions/upload-artifact@v4
        with:
          name: Instalador-CHICAS-Windows
          path: backend/instalador-final/*.exe
</file>

